domain HydroPilot

# HydroPilot описывает компактный контур управления четырьмя зонами измерений
# pH/TDS и четырьмя зонами освещения. Модель намеренно не дублирует Zone1..Zone4:
# текущая работа параметризуется zoneId, а история измерений выносится в отдельную
# activity StoreZoneMeasurement. UART payload формируется централизованными local
# activity, чтобы правила не собирали строки вручную.

# Внешние события.
signal SystemStarted:
  startedAt: Time

signal SchedulerTicked:
  tick: Int
  tickedAt: Time

signal OperatorModeRequested:
  mode: String

signal OperatorMeasurementRequested:
  zoneId: Int

signal OperatorControlRequested:
  zoneId: Int

signal OperatorLightRequested:
  zoneId: Int
  enabled: Bool
  level: Int

signal OperatorCommandRequested:
  zoneId: Int
  commandName: String
  payload: String

signal OperatorEstopRequested:
  reason: String

signal OperatorEstopClearRequested:
  acknowledged: Bool

signal CalibrationRequested:
  zoneId: Int
  kind: String
  referenceValue: Float
  payload: String

signal UartCommandCompleted:
  zoneId: Int
  name: String
  status: String
  errorCode: String
  responseRaw: String

# Системный контекст: режим, готовность и последний tick.
context System:
  mode: String = "manual"
  ready: Bool = false
  startedAt: Time?
  tick: Int = 0
  lastTickAt: Time?

# Состояние UART и единственной очереди команд.
context Uart:
  ready: Bool = false
  connected: Bool = false
  circuitOpen: Bool = false

context Command:
  busy: Bool = false
  currentZoneId: Int = 0
  currentName: String = ""
  currentPayload: String = ""
  currentSource: String = ""
  lastZoneId: Int = 0
  lastName: String = ""
  lastStatus: String = ""
  lastErrorCode: String = ""
  lastResponseRaw: String = ""

# Безопасность хранит защелку interlock и подтвержденный emergency-stop.
context Safety:
  locked: Bool = false
  reason: String = ""
  estopRequested: Bool = false
  estopActive: Bool = false
  clearRequested: Bool = false
  acknowledged: Bool = false

# Измерения описывают не одну зону, а общий слот текущей и последней работы.
# Полная история pH/TDS по зонам хранится во внешней БД через StoreZoneMeasurement.
context Measurement:
  zoneCount: Int = 4
  nextZoneId: Int = 1
  targetZoneId: Int = 0
  latestZoneId: Int = 0
  measurementDue: Bool = false
  storeDue: Bool = false
  recordId: String = ""
  status: String = "unknown"
  phValue: Float = 0.0
  tdsValue: Float = 0.0
  measuredAt: String = ""
  phMin: Float = 5.8
  phMax: Float = 6.5
  tdsMin: Float = 600.0
  tdsMax: Float = 1200.0

# Дозирование тоже параметризовано последней измеренной зоной.
context Dose:
  enabled: Bool = true
  dilutionAvailable: Bool = true
  planReady: Bool = false
  planZoneId: Int = 0
  planKind: String = ""
  planAmountMl: Float = 0.0
  planPayload: String = ""
  minDoseMl: Float = 1.0
  maxDoseMl: Float = 50.0
  safetyFactor: Float = 0.6

# Освещение хранит общий intent для четырех зон света.
context Lighting:
  zoneCount: Int = 4
  targetZoneId: Int = 0
  requested: Bool = false
  desiredEnabled: Bool = false
  desiredLevel: Int = 0
  lastZoneId: Int = 0
  lastEnabled: Bool = false
  lastLevel: Int = 0
  lastStatus: String = "unknown"

# Операторский ввод сведен к намерению режима, ручной команде и калибровке.
context Operator:
  modeRequested: String = ""
  manualCommandRequested: Bool = false
  manualCommandZoneId: Int = 0
  manualCommandName: String = ""
  manualCommandPayload: String = ""
  calibrationRequested: Bool = false
  calibrationZoneId: Int = 0
  calibrationKind: String = ""
  calibrationReferenceValue: Float = 0.0
  calibrationPayload: String = ""
  calibrationPhStatus: String = "valid"
  calibrationTdsStatus: String = "valid"
  calibrationLastZoneId: Int = 0
  calibrationPhLastSuccessAt: Time?
  calibrationTdsLastSuccessAt: Time?
  notifiedSafety: Bool = false
  notifiedCommandFailed: Bool = false
  notifiedCalibrationExpired: Bool = false

# Runtime-флаги оставлены для статуса интеграции, а не для бизнес-логики.
context Runtime:
  ecaReady: Bool = false
  schedulerReady: Bool = false
  uartReady: Bool = false
  persistenceReady: Bool = false
  dashboardReady: Bool = false
  shutdownRequested: Bool = false

# Производные условия.
computed uartReady: Bool =
  Uart.ready and Uart.connected and Uart.circuitOpen == false

computed uartAvailable: Bool =
  uartReady and Command.busy == false

computed validMeasurementZone: Bool =
  Measurement.targetZoneId in [1, 2, 3, 4]

computed validLatestMeasurementZone: Bool =
  Measurement.latestZoneId in [1, 2, 3, 4]

computed validLightZone: Bool =
  Lighting.targetZoneId in [1, 2, 3, 4]

computed validOperatorCommandZone: Bool =
  Operator.manualCommandZoneId in [1, 2, 3, 4]

computed validCalibrationZone: Bool =
  Operator.calibrationZoneId in [1, 2, 3, 4]

computed phLow: Bool =
  Measurement.phValue < Measurement.phMin

computed phHigh: Bool =
  Measurement.phValue > Measurement.phMax

computed tdsLow: Bool =
  Measurement.tdsValue < Measurement.tdsMin

computed tdsHigh: Bool =
  Measurement.tdsValue > Measurement.tdsMax

computed measurementBad: Bool =
  Measurement.status in ["failed", "rejected"]

computed measurementAccepted: Bool =
  Measurement.status == "ok" and validLatestMeasurementZone

computed safetyBlocked: Bool =
  Safety.locked or Safety.estopActive

computed autoControlAllowed: Bool =
  System.mode == "auto" and Dose.enabled and safetyBlocked == false and uartAvailable

computed manualCommandAllowed: Bool =
  System.mode in ["manual", "service"] and safetyBlocked == false and uartAvailable

computed lightingAllowed: Bool =
  System.mode in ["manual", "service", "auto"] and safetyBlocked == false and uartAvailable

computed doseNeeded: Bool =
  phLow or phHigh or tdsLow or tdsHigh

computed dosePlanReady: Bool =
  Dose.planReady and Dose.planZoneId in [1, 2, 3, 4] and Dose.planAmountMl > 0 and Dose.planPayload != ""

computed commandFailed: Bool =
  Command.lastStatus in ["failed", "timeout"]

computed calibrationExpired: Bool =
  Operator.calibrationPhStatus == "expired" or Operator.calibrationTdsStatus == "expired"

# Факты дают runtime короткие имена для условий и expose для диагностик.
fact UartReady when:
  uartReady

fact SafetyBlocked when:
  safetyBlocked
expose:
  reason = Safety.reason

fact MeasurementDue when:
  Measurement.measurementDue
  validMeasurementZone
expose:
  zoneId = Measurement.targetZoneId

fact MeasurementReadyToStore when:
  Measurement.storeDue
  validLatestMeasurementZone
expose:
  zoneId = Measurement.latestZoneId
  ph = Measurement.phValue
  tds = Measurement.tdsValue
  status = Measurement.status

fact DoseNeeded when:
  doseNeeded
  measurementAccepted
expose:
  zoneId = Measurement.latestZoneId

fact DoseReady when:
  dosePlanReady
expose:
  zoneId = Dose.planZoneId
  kind = Dose.planKind
  amountMl = Dose.planAmountMl

fact LightingRequested when:
  Lighting.requested
  validLightZone
expose:
  zoneId = Lighting.targetZoneId
  enabled = Lighting.desiredEnabled
  level = Lighting.desiredLevel

fact CommandFailed when:
  commandFailed
expose:
  zoneId = Command.lastZoneId
  name = Command.lastName
  status = Command.lastStatus
  errorCode = Command.lastErrorCode

fact CalibrationExpired when:
  calibrationExpired

# Политики разделены по типу работы: UART, БД, локальный расчет, уведомления.
policy uartCommandPolicy:
  retry: 3
  timeout: 2s
  backoff: 50ms
  concurrency: once
  idempotency: required
  audit: required

policy databaseWritePolicy:
  retry: 3
  timeout: 5s
  backoff: 100ms
  concurrency: once
  idempotency: required
  audit: required

policy calibrationPolicy:
  retry: 2
  timeout: 10s
  concurrency: once
  idempotency: required
  audit: required

policy localCalculationPolicy:
  retry: 0
  timeout: 1s
  concurrency: once
  idempotency: none
  audit: optional

policy notificationPolicy:
  retry: 2
  timeout: 5s
  concurrency: once
  idempotency: required
  audit: optional

# Local activity формируют UART-команды. Так DSL хранит семантику зоны,
# а конкретный формат протокола остается в одном месте Go-реализации.
activity BuildMeasurementUartRequest:
  require:
    MeasurementDue
  input:
    zoneId = Measurement.targetZoneId
    tick = System.tick
  output:
    commandName: String
    payload: String
  effect: local
  policy: localCalculationPolicy

activity ParseZoneMeasurement:
  input:
    zoneId = Command.lastZoneId
    status = Command.lastStatus
    responseRaw = Command.lastResponseRaw
  output:
    zoneId: Int
    status: String
    phValue: Float
    tdsValue: Float
    measuredAt: String
  effect: local
  policy: localCalculationPolicy

activity StoreZoneMeasurement:
  require:
    MeasurementReadyToStore
  input:
    zoneId = Measurement.latestZoneId
    phValue = Measurement.phValue
    tdsValue = Measurement.tdsValue
    status = Measurement.status
    measuredAt = Measurement.measuredAt
    tick = System.tick
  output:
    stored: Bool
    recordId: String
  effect: external
  idempotencyKey: hash("measurement-db", Measurement.latestZoneId, Measurement.measuredAt)
  policy: databaseWritePolicy

# Расчет плана решает, нужна ли pH-коррекция, питание или разбавление TDS.
activity CalculateDosePlan:
  require:
    DoseNeeded
  input:
    zoneId = Measurement.latestZoneId
    phValue = Measurement.phValue
    phMin = Measurement.phMin
    phMax = Measurement.phMax
    tdsValue = Measurement.tdsValue
    tdsMin = Measurement.tdsMin
    tdsMax = Measurement.tdsMax
    dilutionAvailable = Dose.dilutionAvailable
    minDoseMl = Dose.minDoseMl
    maxDoseMl = Dose.maxDoseMl
    safetyFactor = Dose.safetyFactor
  output:
    ready: Bool
    zoneId: Int
    commandName: String
    kind: String
    amountMl: Float
    payload: String
  effect: local
  policy: localCalculationPolicy

activity BuildLightingUartRequest:
  require:
    LightingRequested
  input:
    zoneId = Lighting.targetZoneId
    enabled = Lighting.desiredEnabled
    level = Lighting.desiredLevel
  output:
    commandName: String
    payload: String
  effect: local
  policy: localCalculationPolicy

activity BuildCalibrationUartRequest:
  input:
    zoneId = Operator.calibrationZoneId
    kind = Operator.calibrationKind
    referenceValue = Operator.calibrationReferenceValue
    payload = Operator.calibrationPayload
  output:
    commandName: String
    payload: String
  effect: local
  policy: localCalculationPolicy

# Все actuator-команды идут через один UART-шлюз.
activity SendUartRequest:
  require:
    UartReady
  input:
    zoneId = Command.currentZoneId
    commandName = Command.currentName
    payload = Command.currentPayload
  output:
    zoneId: Int
    commandName: String
    status: String
    errorCode: String
    responseRaw: String
  effect: external
  idempotencyKey: hash(Command.currentName, Command.currentZoneId, Command.currentPayload, System.tick)
  policy: uartCommandPolicy

activity StoreCalibration:
  input:
    zoneId = Operator.calibrationZoneId
    kind = Operator.calibrationKind
    referenceValue = Operator.calibrationReferenceValue
    responseRaw = Command.lastResponseRaw
  output:
    zoneId: Int
    kind: String
    status: String
    lastSuccessAt: Time
  effect: local
  policy: calibrationPolicy

activity NotifyOperator:
  input:
    safetyReason = Safety.reason
    commandZoneId = Command.lastZoneId
    commandName = Command.lastName
    commandStatus = Command.lastStatus
  output:
    notified: Bool
  effect: external
  idempotencyKey: hash(Safety.reason, Command.lastZoneId, Command.lastName, Command.lastStatus, System.tick)
  policy: notificationPolicy

# Захват входных событий.
rule captureSystemStarted:
  on SystemStarted
  write:
    System.ready = true
    System.startedAt = signal.startedAt
    Runtime.ecaReady = true

rule captureSchedulerTick:
  on SchedulerTicked
  write:
    System.tick = signal.tick
    System.lastTickAt = signal.tickedAt
    Runtime.schedulerReady = true

rule captureModeRequest:
  on OperatorModeRequested
  write:
    Operator.modeRequested = signal.mode

rule captureMeasurementRequest:
  on OperatorMeasurementRequested
  when:
    signal.zoneId in [1, 2, 3, 4]
  write:
    Measurement.targetZoneId = signal.zoneId
    Measurement.measurementDue = true

rule captureControlRequest:
  on OperatorControlRequested
  when:
    signal.zoneId in [1, 2, 3, 4]
  write:
    Measurement.targetZoneId = signal.zoneId
    Measurement.measurementDue = true

rule captureLightRequest:
  on OperatorLightRequested
  when:
    signal.zoneId in [1, 2, 3, 4]
  write:
    Lighting.targetZoneId = signal.zoneId
    Lighting.desiredEnabled = signal.enabled
    Lighting.desiredLevel = signal.level
    Lighting.requested = true

rule captureManualCommand:
  on OperatorCommandRequested
  when:
    signal.zoneId in [1, 2, 3, 4]
  write:
    Operator.manualCommandRequested = true
    Operator.manualCommandZoneId = signal.zoneId
    Operator.manualCommandName = signal.commandName
    Operator.manualCommandPayload = signal.payload

rule captureEstopRequest:
  on OperatorEstopRequested
  write:
    Safety.locked = true
    Safety.reason = signal.reason
    Safety.estopRequested = true

rule captureEstopClearRequest:
  on OperatorEstopClearRequested
  when:
    signal.acknowledged == true
  write:
    Safety.clearRequested = true
    Safety.acknowledged = true

rule captureCalibrationRequest:
  on CalibrationRequested
  when:
    signal.zoneId in [1, 2, 3, 4]
    signal.kind in ["ph", "tds"]
  write:
    Operator.calibrationRequested = true
    Operator.calibrationZoneId = signal.zoneId
    Operator.calibrationKind = signal.kind
    Operator.calibrationReferenceValue = signal.referenceValue
    Operator.calibrationPayload = signal.payload

rule captureUartCompletion:
  on UartCommandCompleted
  write:
    Command.busy = false
    Command.lastZoneId = signal.zoneId
    Command.lastName = signal.name
    Command.lastStatus = signal.status
    Command.lastErrorCode = signal.errorCode
    Command.lastResponseRaw = signal.responseRaw

# Режим меняется только пока нет блокировки безопасности.
rule applyModeChange:
  on changed(Operator.modeRequested)
  when:
    Operator.modeRequested != ""
    Operator.modeRequested != System.mode
    Safety.locked == false
  write:
    System.mode = Operator.modeRequested

rule clearModeRequest:
  on changed(System.mode)
  when:
    Operator.modeRequested == System.mode
  write:
    Operator.modeRequested = ""

# Плановое измерение: каждый tick выбирает следующую зону 1..4.
rule resetMeasurementRoundRobin:
  on changed(Measurement.nextZoneId)
  when:
    Measurement.nextZoneId > Measurement.zoneCount
  write:
    Measurement.nextZoneId = 1

rule markMeasurementDueOnTick:
  on SchedulerTicked
  when:
    System.ready == true
    Measurement.measurementDue == false
    Command.busy == false
  write:
    Measurement.targetZoneId = Measurement.nextZoneId
    Measurement.measurementDue = true

rule queueMeasurementRead:
  on changed(Measurement.measurementDue)
  when:
    Measurement.measurementDue == true
    safetyBlocked == false
    uartAvailable
    validMeasurementZone
  require:
    MeasurementDue
  run: BuildMeasurementUartRequest
  write:
    Command.currentZoneId = Measurement.targetZoneId
    Command.currentName = output.commandName
    Command.currentPayload = output.payload
    Command.currentSource = "measurement"
    Command.busy = true
    Measurement.measurementDue = false

# Критичный путь команды UART.
rule runQueuedUartCommand:
  on changed(Command.busy)
  when:
    Command.busy == true
  require:
    UartReady
  run: SendUartRequest
  write:
    Command.busy = false
    Command.lastZoneId = output.zoneId
    Command.lastName = output.commandName
    Command.lastStatus = output.status
    Command.lastErrorCode = output.errorCode
    Command.lastResponseRaw = output.responseRaw

rule parseMeasurementResult:
  on:
    changed(Command.lastStatus)
    changed(Command.lastResponseRaw)
  when:
    Command.currentSource == "measurement"
    Command.lastStatus == "ok"
  run: ParseZoneMeasurement
  write:
    Measurement.latestZoneId = output.zoneId
    Measurement.status = output.status
    Measurement.phValue = output.phValue
    Measurement.tdsValue = output.tdsValue
    Measurement.measuredAt = output.measuredAt
    Measurement.storeDue = true
    Measurement.nextZoneId = output.zoneId + 1
    Command.currentSource = ""

rule markMeasurementFailed:
  on changed(Command.lastStatus)
  when:
    Command.currentSource == "measurement"
    commandFailed
  write:
    Measurement.latestZoneId = Command.lastZoneId
    Measurement.status = Command.lastStatus
    Measurement.storeDue = true
    Measurement.nextZoneId = Command.lastZoneId + 1
    Command.currentSource = ""

rule storeMeasurementRecord:
  on changed(Measurement.storeDue)
  when:
    Measurement.storeDue == true
  require:
    MeasurementReadyToStore
  run: StoreZoneMeasurement
  write:
    Measurement.recordId = output.recordId
    Measurement.storeDue = false
    Runtime.persistenceReady = output.stored

# Автоконтроль строит один план для последней измеренной зоны.
rule planAutomaticDose:
  on:
    changed(Measurement.status)
    changed(Measurement.phValue)
    changed(Measurement.tdsValue)
    changed(System.mode)
  when:
    measurementAccepted
    autoControlAllowed
    doseNeeded
    Dose.planReady == false
  require:
    DoseNeeded
  run: CalculateDosePlan
  write:
    Dose.planReady = output.ready
    Dose.planZoneId = output.zoneId
    Dose.planKind = output.kind
    Dose.planAmountMl = output.amountMl
    Dose.planPayload = output.payload
    Command.currentZoneId = output.zoneId
    Command.currentName = output.commandName
    Command.currentPayload = output.payload
    Command.currentSource = "auto-dose"
    Command.busy = output.ready

rule skipControlWhenDoseNotNeeded:
  on:
    changed(Measurement.status)
    changed(Measurement.phValue)
    changed(Measurement.tdsValue)
  when:
    measurementAccepted
    doseNeeded == false
  write:
    Dose.planReady = false
    Dose.planZoneId = 0
    Dose.planKind = ""
    Dose.planAmountMl = 0.0
    Dose.planPayload = ""

rule finishAutoDoseCommand:
  on:
    changed(Command.lastStatus)
    changed(Command.lastName)
  when:
    Command.currentSource == "auto-dose"
    Command.lastStatus == "ok"
  write:
    Dose.planReady = false
    Dose.planZoneId = 0
    Dose.planKind = ""
    Dose.planAmountMl = 0.0
    Dose.planPayload = ""
    Command.currentSource = ""

# Освещение: четыре зоны используют один intent и одну сборку UART payload.
rule queueLightingCommand:
  on changed(Lighting.requested)
  when:
    Lighting.requested == true
    lightingAllowed
  require:
    LightingRequested
  run: BuildLightingUartRequest
  write:
    Command.currentZoneId = Lighting.targetZoneId
    Command.currentName = output.commandName
    Command.currentPayload = output.payload
    Command.currentSource = "lighting"
    Command.busy = true

rule finishLightingCommand:
  on:
    changed(Command.lastStatus)
    changed(Command.lastName)
  when:
    Command.currentSource == "lighting"
    Command.lastStatus == "ok"
  write:
    Lighting.lastZoneId = Command.lastZoneId
    Lighting.lastEnabled = Lighting.desiredEnabled
    Lighting.lastLevel = Lighting.desiredLevel
    Lighting.lastStatus = Command.lastStatus
    Lighting.requested = false
    Command.currentSource = ""

# Safety-команды тоже идут через общий UART-шлюз.
rule queueEstopOn:
  on:
    changed(Safety.estopRequested)
    changed(Uart.connected)
  when:
    Safety.estopRequested == true
    Safety.estopActive == false
    uartAvailable
  write:
    Command.currentZoneId = 0
    Command.currentName = "safety.estopOn"
    Command.currentPayload = "0:SYS:ESTOP:SET:ON"
    Command.currentSource = "safety"
    Command.busy = true

rule queueEstopOff:
  on:
    changed(Safety.clearRequested)
    changed(Uart.connected)
  when:
    Safety.clearRequested == true
    Safety.estopActive == true
    uartAvailable
  write:
    Command.currentZoneId = 0
    Command.currentName = "safety.estopOff"
    Command.currentPayload = "0:SYS:ESTOP:SET:OFF"
    Command.currentSource = "safety"
    Command.busy = true

rule finishSafetyCommand:
  on:
    changed(Command.lastStatus)
    changed(Command.lastName)
  when:
    Command.currentSource == "safety"
    Command.lastStatus == "ok"
  write:
    Safety.estopActive = Command.lastName == "safety.estopOn"
    Safety.estopRequested = Command.lastName == "safety.estopOn"
    Command.currentSource = ""

rule unlockAfterSafeAck:
  on:
    changed(Safety.acknowledged)
    changed(Safety.estopActive)
  when:
    Safety.acknowledged == true
    Safety.estopActive == false
    Safety.locked == true
  write:
    Safety.locked = false
    Safety.reason = ""
    Safety.clearRequested = false
    Safety.acknowledged = false

# Ручные команды используют тот же шлюз, но только в manual/service.
rule queueManualCommand:
  on changed(Operator.manualCommandRequested)
  when:
    Operator.manualCommandRequested == true
    validOperatorCommandZone
    manualCommandAllowed
  write:
    Command.currentZoneId = Operator.manualCommandZoneId
    Command.currentName = Operator.manualCommandName
    Command.currentPayload = Operator.manualCommandPayload
    Command.currentSource = "manual"
    Command.busy = true

rule finishManualCommand:
  on:
    changed(Command.lastStatus)
    changed(Command.lastName)
  when:
    Command.currentSource == "manual"
    Command.lastStatus == "ok"
  write:
    Operator.manualCommandRequested = false
    Operator.manualCommandZoneId = 0
    Operator.manualCommandName = ""
    Operator.manualCommandPayload = ""
    Command.currentSource = ""

rule queueCalibrationCommand:
  on changed(Operator.calibrationRequested)
  when:
    Operator.calibrationRequested == true
    validCalibrationZone
    manualCommandAllowed
  run: BuildCalibrationUartRequest
  write:
    Command.currentZoneId = Operator.calibrationZoneId
    Command.currentName = output.commandName
    Command.currentPayload = output.payload
    Command.currentSource = "calibration"
    Command.busy = true

rule storePhCalibrationResult:
  on:
    changed(Command.lastStatus)
    changed(Command.lastName)
  when:
    Command.currentSource == "calibration"
    Operator.calibrationKind == "ph"
    Command.lastStatus == "ok"
  run: StoreCalibration
  write:
    Operator.calibrationRequested = false
    Operator.calibrationLastZoneId = output.zoneId
    Operator.calibrationKind = ""
    Operator.calibrationPayload = ""
    Command.currentSource = ""
    Operator.calibrationPhStatus = output.status
    Operator.calibrationPhLastSuccessAt = output.lastSuccessAt

rule storeTdsCalibrationResult:
  on:
    changed(Command.lastStatus)
    changed(Command.lastName)
  when:
    Command.currentSource == "calibration"
    Operator.calibrationKind == "tds"
    Command.lastStatus == "ok"
  run: StoreCalibration
  write:
    Operator.calibrationRequested = false
    Operator.calibrationLastZoneId = output.zoneId
    Operator.calibrationKind = ""
    Operator.calibrationPayload = ""
    Command.currentSource = ""
    Operator.calibrationTdsStatus = output.status
    Operator.calibrationTdsLastSuccessAt = output.lastSuccessAt

# Уведомления намеренно одноразовые, чтобы runtime не спамил оператора.
rule notifySafetyOnce:
  on changed(Safety.locked)
  when:
    Safety.locked == true
    Operator.notifiedSafety == false
  run: NotifyOperator
  write:
    Operator.notifiedSafety = output.notified

rule notifyCommandFailedOnce:
  on changed(Command.lastStatus)
  when:
    commandFailed
    Operator.notifiedCommandFailed == false
  require:
    CommandFailed
  run: NotifyOperator
  write:
    Operator.notifiedCommandFailed = output.notified

rule notifyCalibrationExpiredOnce:
  on:
    changed(Operator.calibrationPhStatus)
    changed(Operator.calibrationTdsStatus)
  when:
    calibrationExpired
    Operator.notifiedCalibrationExpired == false
  require:
    CalibrationExpired
  run: NotifyOperator
  write:
    Operator.notifiedCalibrationExpired = output.notified

# Инварианты фиксируют смысл параметризованной модели.
claim safetyBlocksActuators:
  always:
    safetyBlocked == true implies Command.currentSource != "auto-dose"
    safetyBlocked == true implies Command.currentSource != "manual"
    safetyBlocked == true implies Command.currentSource != "lighting"

claim zoneIdsStayBounded:
  always:
    Measurement.targetZoneId == 0 or validMeasurementZone
    Lighting.targetZoneId == 0 or validLightZone

claim dosePlanHasPayloadAmountAndZone:
  always:
    Dose.planReady == true implies dosePlanReady

claim measurementStoreRequiresLatestZone:
  always:
    Measurement.storeDue == true implies validLatestMeasurementZone

claim commandResultIsRecorded:
  always:
    Command.lastName != "" implies Command.lastStatus exists

claim calibrationNotificationMirrorsState:
  always:
    Operator.notifiedCalibrationExpired == true implies calibrationExpired

# Статусная проекция показывает raw-значения и derived-флаги без дублирования зон.
query HydroPilotStatus:
  return:
    mode = System.mode
    ready = System.ready
    tick = System.tick
    uartReady = uartAvailable
    commandBusy = Command.busy
    commandZoneId = Command.currentZoneId
    commandCurrent = Command.currentName
    commandSource = Command.currentSource
    commandLastZoneId = Command.lastZoneId
    commandLast = Command.lastName
    commandStatus = Command.lastStatus
    safetyLocked = Safety.locked
    safetyReason = Safety.reason
    estopActive = Safety.estopActive
    measurementZoneCount = Measurement.zoneCount
    measurementNextZoneId = Measurement.nextZoneId
    measurementTargetZoneId = Measurement.targetZoneId
    measurementLatestZoneId = Measurement.latestZoneId
    measurementDue = Measurement.measurementDue
    measurementStoreDue = Measurement.storeDue
    measurementRecordId = Measurement.recordId
    measurementStatus = Measurement.status
    ph = Measurement.phValue
    tds = Measurement.tdsValue
    phLow = phLow
    phHigh = phHigh
    tdsLow = tdsLow
    tdsHigh = tdsHigh
    measurementBad = measurementBad
    measurementAccepted = measurementAccepted
    doseNeeded = doseNeeded
    dosePlanReady = dosePlanReady
    dosePlanZoneId = Dose.planZoneId
    dosePlanKind = Dose.planKind
    dosePlanAmountMl = Dose.planAmountMl
    lightingZoneCount = Lighting.zoneCount
    lightingTargetZoneId = Lighting.targetZoneId
    lightingRequested = Lighting.requested
    lightingEnabled = Lighting.desiredEnabled
    lightingLevel = Lighting.desiredLevel
    lightingLastZoneId = Lighting.lastZoneId
    lightingLastStatus = Lighting.lastStatus
    commandFailed = commandFailed
    calibrationExpired = calibrationExpired
